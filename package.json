{
	"name": "@nestm/better-auth",
	"version": "0.1.0-alpha.10",
	"description": "Better Auth integration for NestJS 12 (ESM)",
	"license": "BSD-3-Clause",
	"author": "nestm",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nestm-dev/better-auth.git"
	},
	"homepage": "https://github.com/nestm-dev/better-auth#readme",
	"bugs": {
		"url": "https://github.com/nestm-dev/better-auth/issues"
	},
	"keywords": [
		"nestjs",
		"nestjs-12",
		"better-auth",
		"auth",
		"authentication",
		"esm",
		"nestm"
	],
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.13.0"
	},
	"packageManager": "pnpm@11.24.0",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./typeorm": {
			"types": "./dist/typeorm/index.d.mts",
			"import": "./dist/typeorm/index.mjs",
			"default": "./dist/typeorm/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch src",
		"build:tsc": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
		"test": "pnpm run test:express && pnpm run test:fastify",
		"test:express": "cross-env TEST_HTTP_ADAPTER=express vitest run",
		"test:fastify": "cross-env TEST_HTTP_ADAPTER=fastify vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:postgres": "tsc -p tests/postgres/tsconfig.json && cross-env TZ=America/Sao_Paulo vitest run --config vitest.postgres.config.ts",
		"verify:pack": "pnpm run build && publint --strict && pnpm run test:packed-types",
		"test:packed-types": "tsc -p tests/packed-types/tsconfig.json",
		"prepack": "pnpm run build",
		"changeset": "changeset",
		"release": "node scripts/publish.mjs"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0",
		"@nestjs/core": "^12.0.0",
		"@nestjs/graphql": "^14.0.0",
		"@nestjs/websockets": "^12.0.0",
		"better-auth": ">=1.7.2 <1.8.0-0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.0",
		"typeorm": "^1.1.0"
	},
	"peerDependenciesMeta": {
		"@nestjs/graphql": {
			"optional": true
		},
		"@nestjs/websockets": {
			"optional": true
		},
		"typeorm": {
			"optional": true
		}
	},
	"devDependencies": {
		"@better-auth/drizzle-adapter": "1.7.2",
		"@better-auth/mcp": "1.7.2",
		"@changesets/cli": "3.0.1",
		"@nestjs/common": "12.0.1",
		"@nestjs/core": "12.0.1",
		"@nestjs/platform-express": "12.0.1",
		"@nestjs/platform-fastify": "12.0.1",
		"@nestjs/platform-socket.io": "12.0.1",
		"@nestjs/testing": "12.0.1",
		"@nestjs/websockets": "12.0.1",
		"@types/node": "26.4.0",
		"@types/pg": "^8.23.1",
		"@types/supertest": "7.2.1",
		"@vitest/coverage-v8": "4.1.11",
		"better-auth": "1.7.2",
		"cross-env": "10.1.0",
		"drizzle-orm": "^0.45.2",
		"fastify": "5.12.3",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"pg": "^8.23.0",
		"postgres": "^3.4.9",
		"prettier": "3.9.6",
		"publint": "0.3.24",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"socket.io": "4.8.3",
		"socket.io-client": "4.8.3",
		"supertest": "7.2.2",
		"tsdown": "0.22.14",
		"typeorm": "1.1.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
